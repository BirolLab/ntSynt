#!/usr/bin/env snakemake -s
"""
Snakemake pipeline: multi-genome synteny analysis
==================================================
Inputs  (all set in config.yaml):
  - accessions_tsv   : TSV with at minimum an "Assembly Accession" column
  - taxonomic_group  : string used for naming outputs (e.g. "ichneumonidae")
  - fpr              : false-positive rate passed to ntSynt  (e.g. 0.025)
  - ntsynt_k         : k-mer size for ntSynt                (e.g. 24)
  - ntsynt_w         : minimizer window size for ntSynt     (e.g. 1000)
  - treefile         : (optional) Newick tree for ntSynt-viz; set to "" to omit
  - scripts          : mapping of script names to their paths on disk

Steps
-----
  1.  download_assemblies   – datasets download + unzip; flatten fai via samtools
  2.  list_fastas           – write a text file of all discovered *.fna paths
  3.  abyss_fac             – chromosome / contig length stats
  4.  mash_sketch_full      – mash sketch of full assemblies
  5.  mash_dist_full        – all-vs-all mash dist on full assemblies
  6.  max_mash_dist         – extract scalar max distance → used as ntSynt -d
  7.  mash_sketch_syntenic  – mash sketch of syntenic   FASTA files
  8.  mash_sketch_nonsyntenic – mash sketch of non-syntenic FASTA files
  9.  mash_dist_syntenic    – pairwise mash dist on syntenic regions
  10. mash_dist_nonsyntenic – pairwise mash dist on non-syntenic regions
  11. run_ntsynt            – ntSynt proper
  12. ntsynt_block_stats    – denovo_synteny_block_stats.py
  13. ntsynt_mx_stats       – analyze_mx.py (minimizer stats)
  14. run_ntsynt_viz        – ntsynt_viz.py
  15. extract_synteny_regions – extract_synteny_regions.py (syntenic/non-syntenic FASTA)
  16. discontinuity_reasons – awk/python tally of block-break reasons
  17. plot_divergences      – Rscript plot_dists.R (all three distributions)
  18. name_conversion       – auto-generated from accessions TSV
"""

import os, glob, sys, shutil

# ---------------------------------------------------------------------------
# Convenience aliases
# ---------------------------------------------------------------------------
PREFIX   = config.get("prefix")

ACCESSIONS = config.get("accessions") or ""
GENOMES = config.get("genomes") or ""
NAME_CONVERSIONS = config.get("name_conversions", "")
FPR       = config["fpr"]
K         = config["ntsynt_k"]
W         = config["ntsynt_w"]
SCRIPTS   = config["scripts_dir"]           
TREEFILE  = config.get("treefile", "")
MAKE_TREE = config.get("make_tree", False)
MT_GENOMES = config.get("mt_genomes") or ""
MT_NAME_CONVERSIONS = config.get("mt_name_conversions") or ""

HASHES        = config.get("hashes") or ""
TARGET_GENOME = config.get("target_genome") or ""
VIZ_LENGTH    = config.get("viz_length") or ""
VIZ_FORMAT    = config.get("viz_format") or "png"
VIZ_WIDTH     = config.get("viz_width") or ""
VIZ_DPI       = config.get("viz_dpi") or ""
CENTROMERES   = config.get("centromeres") or ""
VIZ_ORDER     = config.get("viz_order") or ""
VIZ_KEEP      = config.get("viz_keep") or ""
NO_ARROW      = config.get("no_arrow", False)
NTSYNT_VIZ_RIBBON_ADJUST = config.get("ntsynt_viz_ribbon_adjust", 0.2)
VIZ_OPTIMIZE_ORDERING = config.get("optimize_ordering") or ""

NTSYNT_VIZ_RIBBON_PLOT = (
    f"{PREFIX}_ribbon-plot_tree.{VIZ_FORMAT}" if MAKE_TREE or TREEFILE
    else f"{PREFIX}_ribbon-plot.{VIZ_FORMAT}"
)

NTSYNT_VIZ_RIBBON_PLOT_HTML = (
    f"{PREFIX}_ribbon-plot_tree.html" if MAKE_TREE or TREEFILE
    else f"{PREFIX}_ribbon-plot.html"
)

ASSEMBLY_DIR  = f"{PREFIX}_assemblies"
NCBI_DATA_DIR = f"{ASSEMBLY_DIR}/{PREFIX}_assemblies/ncbi_dataset/data" if ACCESSIONS else ASSEMBLY_DIR
MASH_DIR      = f"mash"
VIZ_DIR       = f"ntsynt-viz"

# ntSynt output file stem (matches ntSynt naming convention)
NTSYNT_STEM = f"ntSynt.k{K}.w{W}"
BLOCKS_TSV  = f"{NTSYNT_STEM}.synteny_blocks.tsv"

# Hidden arguments
BLOCK_SIZE = config.get("block_size") or ""
INDEL = config.get("indel") or ""
MERGE = config.get("merge") or ""
SCALE = config.get("scale") or ""
SEQ_LENGTH = config.get("seq_length") or ""
W_ROUNDS = config.get("w_rounds") or ""

# ---------------------------------------------------------------------------
# Helper: discover FASTAs after download (populated by checkpoint)
# ---------------------------------------------------------------------------

def get_fastas(_=None):
    """Return list of *.fna paths under the NCBI data directory."""
    return [os.path.abspath(f) for f in glob.glob(f"{NCBI_DATA_DIR}/**/*.chr.fa.gz", recursive=True)]


def get_fai_list(_=None):
    return [f + ".fai" for f in get_fastas()]


# ---------------------------------------------------------------------------
# Target rule
# ---------------------------------------------------------------------------

rule all:
    input:
        # Chromosome stats
        f"{ASSEMBLY_DIR}/{PREFIX}_abyss_fac.tsv",
        f"{ASSEMBLY_DIR}/{PREFIX}_abyss_fac-summary.tsv",
        # Mash
        f"{MASH_DIR}/full_assemblies_dist.tsv",
        # ntSynt outputs
        BLOCKS_TSV,
        f"{NTSYNT_STEM}.synteny_blocks.stats.tsv",
        # ntSynt-viz
        f"{VIZ_DIR}/ntsynt_viz.done",
        # Syntenic / non-syntenic FASTAs
        f"regions_extracted.done",
        # Discontinuity reasons
        f"{NTSYNT_STEM}.discontinuity_reasons.tsv",
        # Divergence plots
        f"{MASH_DIR}/mash_divergence_boxplot.pdf",
        # HTML and PDF report,
        f"{PREFIX}_ntsynt_report.html",
        f"{PREFIX}_ntsynt_report.pdf",

rule kmc:
    input:
        f"{NTSYNT_STEM}.mx.stats.tsv",


# ===========================================================================
# Download assemblies - if accessions specified
# ===========================================================================

rule download_assemblies_sequence_reports:
    input: 
        acc_tsv = ACCESSIONS
    output:
        seq_report = f"{ASSEMBLY_DIR}/{PREFIX}_sequence-reports.tsv"
    shell:
        r"""
        datasets summary genome accession --inputfile {input.acc_tsv} \
            --report sequence --assembly-level chromosome,complete \
            --as-json-lines \
        |dataformat tsv genome-seq --fields accession,chr-name,genbank-seq-acc,mol-type,role \
            > {output.seq_report}
        """

rule download_assemblies_ncbi:
    input:
        accfile = ACCESSIONS,
    output:
        done    = f"{ASSEMBLY_DIR}/download.done",
    params:
        prefix = PREFIX,
        outdir     = ASSEMBLY_DIR,
    shell:
        """
        datasets download genome accession \
            --include genome \
            --assembly-level complete,chromosome \
            --inputfile {input.accfile} \
            --filename {params.outdir}/{params.prefix}_assemblies.zip

        unzip -o {params.outdir}/{params.prefix}_assemblies.zip \
              -d {params.outdir}/{params.prefix}_assemblies
        rm -f {params.outdir}/{params.prefix}_assemblies.zip

        # Reset timestamps on all extracted files to avoid Snakemake mtime issues
        find {params.outdir}/{params.prefix}_assemblies -exec touch {{}} \\; 

        touch {output.done}
        """

# ===========================================================================
# Filter downloaded assemblies to retain chromosome sequences only
# ===========================================================================

rule filter_assemblies_to_chromosomes:
    """
    For each downloaded assembly, filter the sequence report to
    assembled-molecule chromosomes, then extract those sequences
    with seqtk subseq into <accession>.chr.fa.gz alongside the original *.fna.
    Also writes a per-accession <accession>.chromosomes.tsv for reference.
    """
    input:
        accfile    = ACCESSIONS,
        seq_report = rules.download_assemblies_sequence_reports.output.seq_report,
        done       = f"{ASSEMBLY_DIR}/download.done",
    output:
        done = f"{ASSEMBLY_DIR}/filter_chromosomes.done",
    params:
        fasta_root = f"{ASSEMBLY_DIR}/{PREFIX}_assemblies/ncbi_dataset/data",
    log:
        f"{ASSEMBLY_DIR}/filter_chromosomes.log",
    shell:
        r"""
        set -eux -o pipefail

        while read -r accession; do
            accession=${{accession%$'\r'}}   # strip Windows line endings
            echo "Processing $accession" | tee -a {log}

            fasta=$(find {params.fasta_root}/${{accession}} -name "*.fna")
            count_fasta=$(echo "${{fasta}}" | wc -l)

            if [ "${{count_fasta}}" -ne 1 ]; then
                echo "ERROR: ${{count_fasta}} FASTA files found for $accession, expected 1." \
                    | tee -a {log}
                exit 1
            fi

            # Filter sequence report to assembled-molecule chromosomes for this accession,
            # saving a per-accession TSV for reference
            chr_tsv={params.fasta_root}/${{accession}}/${{accession}}.chromosomes.tsv
            mlr --tsv \
                filter -s my_acc="$accession" '$["Assembly Accession"] == @my_acc' \
                then filter '$Role == "assembled-molecule" && ($["Molecule type"] == "Chromosome" || $["Molecule type"] == "Linkage Group" )' \
                {input.seq_report} > "$chr_tsv"

            n_chr=$(tail -n +2 "$chr_tsv" | wc -l)
            echo "  Found ${{n_chr}} chromosome sequence(s)" | tee -a {log}

            if [ "${{n_chr}}" -eq 0 ]; then
                echo "  WARNING: no chromosome sequences found for $accession, skipping." \
                    | tee -a {log}
                continue
            fi

            # Extract chromosome sequences using seqtk subseq
            out={params.fasta_root}/${{accession}}/${{accession}}.chr.fa.gz
            seqtk subseq "$fasta" \
                <(mlr --tsv cut -f "GenBank seq accession" "$chr_tsv" | tail -n +2) |pigz \
                > "$out"
            pigz "$fasta"
            gunzip -c "$out" | samtools faidx -o "$out".fai -
            echo "  Written: $out" | tee -a {log}

        done < {input.accfile}

        touch {output.done}
        """

# ===========================================================================
# GENOMES mode: stage user-supplied genome FASTAs (bypasses NCBI download)
# ===========================================================================

rule stage_genomes:
    """
    For GENOMES mode, symlink each user-supplied genome FASTA
    """
    input:
        genomes = GENOMES,
    output:
        done = f"{ASSEMBLY_DIR}/genomes_staged.done",
        fasta_list = f"{ASSEMBLY_DIR}/{PREFIX}_fasta_list.txt"
    params:
        fasta_root = ASSEMBLY_DIR,
    log:
        f"{ASSEMBLY_DIR}/stage_genomes.log",
    shell:
        r"""
        set -eux -o pipefail
        while read -r genome_path; do
            base=$(basename ${{genome_path}})
            full_path=$(realpath ${{genome_path}})
            ln -sf "$full_path" {params.fasta_root}/${{base}}
            echo $(pwd)/{params.fasta_root}/${{base}} >> {output.fasta_list}
        done < {input.genomes}

        touch {output.done}
        """


# ===========================================================================
# Index all FASTAs with samtools faidx
# ===========================================================================

def get_index_fastas_input():
    """Get the appropriate status file for the mode being run"""
    if ACCESSIONS:
        return f"{ASSEMBLY_DIR}/filter_chromosomes.done"
    elif GENOMES:
        return f"{ASSEMBLY_DIR}/genomes_staged.done"

checkpoint index_fastas:
    """
    Index every assemble FASTA file under the assembly directory.
    Using a checkpoint so downstream rules can glob the actual file list.
    """
    input:
        index_fasta_flag = get_index_fastas_input(),
    output:
        done = f"{ASSEMBLY_DIR}/index_fastas.done",
    run:
        if f"{ASSEMBLY_DIR}/genomes_staged.done" in input.index_fasta_flag:
            shell(r"""
                set -eux -o pipefail
                while read -r genome_file; do 
                    base=$(basename ${{genome_file}})
                    if [[ "${{base}}" == *.gz ]]; then
                        gunzip -c "${{genome_file}}" | samtools faidx -o "{ASSEMBLY_DIR}/${{base}}.fai"  -
                    else
                        samtools faidx -o "{ASSEMBLY_DIR}/${{base}}.fai" "${{genome_file}}"
                    fi                
                done < {GENOMES}
                touch {output.done}
                """)
        else:
            shell(r"""
                set -eux -o pipefail
                find {NCBI_DATA_DIR} -name '*.chr.fa.gz' | while read fa; do
                    if [ ! -f "$fa.fai" ]; then
                        gunzip -c "$fa" | samtools faidx -o "${{fa}}.fai" -
                    fi
                done
                touch {output.done}
                """)


# ===========================================================================
# Write a plain-text list of all downloaded FASTA paths (used by downstream steps)
# ===========================================================================

rule list_fastas:
    input:
        f"{ASSEMBLY_DIR}/index_fastas.done",
        f"{ASSEMBLY_DIR}/filter_chromosomes.done",
    output:
        fasta_list = f"{ASSEMBLY_DIR}/{PREFIX}_fasta_list.txt",
    run:
        fastas = get_fastas()
        if not fastas:
            raise ValueError(
                f"No *.chr.fa.gz files found under {NCBI_DATA_DIR}. "
                "Check that download_assemblies completed successfully."
            )
        with open(output.fasta_list, "w") as fh:
            fh.write("\n".join(fastas) + "\n")



# ===========================================================================
# Chromosome / contig stats with abyss-fac
# ===========================================================================

# Ensure that we use the appropriate path to obtain fasta_list
if ACCESSIONS:
    FASTA_LIST = rules.list_fastas.output.fasta_list
else:
    FASTA_LIST = rules.stage_genomes.output.fasta_list

rule abyss_fac:
    input:
        fasta_list = FASTA_LIST,
    output:
        stats = f"{ASSEMBLY_DIR}/{PREFIX}_abyss_fac.tsv",
    shell:
        r"""
        set -euo pipefail
        abyss-fac $(cat {input.fasta_list} | tr "\n" " ") > {output.stats}
        """

rule abyss_fac_stats:
    input:
        stats = rules.abyss_fac.output.stats,
    output:
        summary = f"{ASSEMBLY_DIR}/{PREFIX}_abyss_fac-summary.tsv",
    shell:
        r"""
        mlr --tsv stats1 -a min,max,count -f n,sum \
            then cut -o -f n_count,n_min,n_max,sum_min,sum_max \
            {input.stats} > {output.summary}
        """


# ===========================================================================
# Mash — sketch and all-vs-all dist on full assemblies
# ===========================================================================

rule mash_sketch_full:
    input:
        fasta_list = FASTA_LIST,
    output:
        dist = f"{MASH_DIR}/full_assemblies_dist.tsv",
    params:
        sketch_size = 50000
    threads: workflow.cores
    shell:
        r"""
        mash triangle -p {threads} -s {params.sketch_size} -E -l {input.fasta_list} > {output.dist}
        """

# ===========================================================================
# Extract max mash distance → divergence for ntSynt
# ===========================================================================

rule max_mash_dist:
    input:
        dist = f"{MASH_DIR}/full_assemblies_dist.tsv",
    output:
        max_dist = f"{MASH_DIR}/max_mash_dist.txt",
    shell:
        r"""
        max_d=$(awk 'BEGIN{{max=0}} {{if($3>max) max=$3}} END{{printf "%.2f", max*100}}' {input.dist})
        echo $max_d > {output.max_dist}
        echo "  Max mash distance: ${{max_d}}"
        """

# ===========================================================================
# Run ntSynt
# ===========================================================================

rule run_ntsynt:
    input:
        fasta_list = FASTA_LIST,
        max_dist   = f"{MASH_DIR}/max_mash_dist.txt",
    output:
        blocks = BLOCKS_TSV,
    log:
        f"ntsynt.log",
    threads: workflow.cores
    params:
        fpr      = FPR,
        hashes   = f"--hashes {HASHES}" if HASHES else "",
        block_size = f"-b {BLOCK_SIZE}" if BLOCK_SIZE else "",
        indel    = f"--indel {INDEL}" if INDEL else "",
        merge    = f"--merge {MERGE}" if MERGE else "",
        w_rounds = f"--w_rounds {' '.join(str(x) for x in W_ROUNDS)}" if W_ROUNDS else "",
    shell:
        r"""
        set -euo pipefail
        divergence=$(cat {input.max_dist})
        /usr/bin/time -pv ntSynt \
            --fastas_list {input.fasta_list} \
            -d ${{divergence}} \
            --fpr {params.fpr} \
            -k {K} \
            -w {W} \
            -t {threads} \
            {params.hashes} \
            {params.block_size} {params.indel} {params.merge} {params.w_rounds} \
            --benchmark \
            &> {log}
        """


# ===========================================================================
# ntSynt block stats
# ===========================================================================

rule ntsynt_block_stats:
    input:
        blocks = BLOCKS_TSV,
        done   = f"{ASSEMBLY_DIR}/index_fastas.done",
    output:
        stats = f"{NTSYNT_STEM}.synteny_blocks.stats.tsv",
    params:
        script = f"{SCRIPTS}/denovo_synteny_block_stats.py",
    shell:
        r"""
        fais=$(find {NCBI_DATA_DIR} -name '*.fai' | tr "\n" " ")
        python3 {params.script} \
            --tsv {input.blocks} \
            --fai $fais \
            > {output.stats}
        """

# ===========================================================================
# ntSynt minimizer stats - optional
# ===========================================================================

rule ntsynt_mx_stats:
    input:
        blocks     = BLOCKS_TSV,
        fasta_list = FASTA_LIST,
    output:
        stats   = f"{NTSYNT_STEM}.mx.stats.tsv",
        mx_list = f"mx_files.txt",
    params:
        script = f"{SCRIPTS}/analyze_mx.py",
        k      = K,
        w      = W,
    shell:
        r"""
        set -euo pipefail
        ls *.k{params.k}.w{params.w}.tsv > {output.mx_list}
        python3 {params.script} \
            --bf {NTSYNT_STEM}.common.bf \
            --mx {output.mx_list} \
            -k {params.k} \
            --fastas {input.fasta_list} \
            --dot {NTSYNT_STEM}.mx.dot \
            1> {output.stats}
        """

# ===========================================================================
# Fix name conversion
# ===========================================================================
rule finalize_name_conversion:
    input:
        name_conv = NAME_CONVERSIONS
    output:
        format_name_conv = f"{PREFIX}_name_conversion.tsv"
    run:
        if ACCESSIONS:
            with open(input.name_conv) as infile, open(output.format_name_conv, "w") as outfile:
                for line in infile:
                    line = line.rstrip("\n")
                    if not line:
                        continue
                    accession, new_name = line.split("\t")
                    outfile.write(f"{accession}.chr.fa.gz\t{new_name}\n")
        if GENOMES:
            os.symlink(os.path.abspath(input.name_conv), output.format_name_conv)

# ===========================================================================
# ntSynt-viz
# ===========================================================================

def get_treefile(wildcards):
    if TREEFILE:
        return TREEFILE
    if MAKE_TREE:
        return f"phylogeny/tree/{PREFIX}.nwk"
    return []

def get_treefile_path(wildcards):
    if TREEFILE:
        return os.path.abspath(TREEFILE)
    if MAKE_TREE:
        return os.path.abspath(f"phylogeny/tree/{PREFIX}.nwk")
    return []

rule make_tree:
    input:
        fastas = FASTA_LIST,
        name_conv = rules.finalize_name_conversion.output.format_name_conv
    output:
        tree = f"phylogeny/tree/{PREFIX}.nwk",
        out_type = "phylogeny/mt/use_nuclear.flag"
    threads: workflow.cores
    params:
        mt_source = "--mt-source user-fasta" if MT_GENOMES else "",
        mt_assemblies = f"--mt-fasta {MT_GENOMES}" if MT_GENOMES else "",
        name_conv = lambda wildcards, input: MT_NAME_CONVERSIONS if MT_GENOMES else input.name_conv,
    shell:
        "run_phylogeny.py --prefix {PREFIX} --name-conversion {params.name_conv} {params.mt_source} {params.mt_assemblies} --cores {threads}"

rule run_ntsynt_viz:
    input:
        blocks    = BLOCKS_TSV,
        name_conv = rules.finalize_name_conversion.output.format_name_conv,
        done      = f"{ASSEMBLY_DIR}/index_fastas.done",
        treefile = get_treefile,
    output:
        links = f"{VIZ_DIR}/{PREFIX}.sequence_lengths.sorted.tsv",
        done = f"{VIZ_DIR}/ntsynt_viz.done",
        out_plot = f"{VIZ_DIR}/{NTSYNT_VIZ_RIBBON_PLOT}",
        out_html = f"{VIZ_DIR}/{NTSYNT_VIZ_RIBBON_PLOT_HTML}"
    log:
        f"ntsynt_viz.log",
    params:
        prefix        = PREFIX,
        treeflag      = lambda wildcards, input: (f"--tree {p}" if (p := get_treefile_path(wildcards)) else ""),
        ribbon_adjust = NTSYNT_VIZ_RIBBON_ADJUST,
        block_length  = f"--length {VIZ_LENGTH}" if VIZ_LENGTH else (f"--length {int(BLOCK_SIZE)}" if BLOCK_SIZE else ""),
        indel         = f"--indel {INDEL}" if INDEL else "",
        scale         = f"--scale {SCALE}" if SCALE else "",
        seq_length    = f"--seq_length {int(SEQ_LENGTH)}" if SEQ_LENGTH else "",
        target_genome = f"--target-genome {TARGET_GENOME}" if TARGET_GENOME else "",
        viz_format    = f"--format {VIZ_FORMAT}",
        viz_width     = f"--width {VIZ_WIDTH}" if VIZ_WIDTH else "",
        viz_dpi       = f"--dpi {VIZ_DPI}" if VIZ_DPI else "",
        centromeres   = f"--centromeres ../{CENTROMERES}" if CENTROMERES else "",
        viz_order     = f"--order ../{VIZ_ORDER}" if VIZ_ORDER else "",
        viz_keep      = f"--keep {VIZ_KEEP}" if VIZ_KEEP else "",
        no_arrow      = "--no-arrow" if NO_ARROW else "",
        optimize_order = "--optimize-ordering" if VIZ_OPTIMIZE_ORDERING else "",
    run:
        shell(
            """
            set -eux -o pipefail
            mkdir -p {VIZ_DIR} && cd {VIZ_DIR}
            find ../{NCBI_DATA_DIR} -name '*.fai' > fais.txt
            """
            )
        with open(f"{VIZ_DIR}/fais.txt", 'r') as f:
            lines = f.readlines()
            num_assemblies = len(lines)
        height = max(min(num_assemblies * 2, 75), 20)
        shell("""
            set -eux -o pipefail
            cd {VIZ_DIR}
            ntsynt_viz.py --blocks ../{input.blocks} \
                --fai fais.txt \
                --name_conversion ../{input.name_conv} \
                --prefix {params.prefix} \
                --normalize \
                --ribbon_adjust {params.ribbon_adjust} \
                --height {height} \
                --annotate-genome-info \
                {params.treeflag} {params.scale} \
                {params.block_length} {params.indel} {params.seq_length} \
                {params.target_genome} \
                {params.viz_format} {params.viz_width} {params.viz_dpi} \
                {params.centromeres} {params.viz_order} {params.viz_keep} \
                {params.no_arrow} \
                &> {log}
            cd ../
            touch {output.done}
        """
        )


# ===========================================================================
# Extract syntenic / non-syntenic regions per assembly
# ===========================================================================

rule extract_synteny_regions:
    """
    Runs extract_synteny_regions.py.
    Produces <accession>.syntenic.fa and <accession>.non_syntenic.fa for
    every assembly present in the synteny blocks TSV.
    """
    input:
        blocks     = BLOCKS_TSV,
        fasta_list = FASTA_LIST,
    output:
        done = "regions_extracted.done",
        regions = temporary(directory("synteny_regions"))
    params:
        script  = f"{SCRIPTS}/extract_synteny_regions.py",
    shell:
        r"""
        set -eux -o pipefail
        mkdir -p {output.regions}
        fastas=$(cat {input.fasta_list} | tr "\n" " ")
        python3 {params.script} \
            --synteny {input.blocks} \
            --fastas ${{fastas}} \
            --outdir {output.regions}
        touch {output.done}
        """


# ===========================================================================
# Mash on syntenic / non-syntenic regions
# ===========================================================================

rule mash_regions:
    wildcard_constraints:
        region_type = "syntenic|non_syntenic",
    input:
        done = f"regions_extracted.done",
        input_regions = directory("synteny_regions")
    output:
        dist = f"{MASH_DIR}/{{region_type}}_dists.tsv",
    params:
        regions = f"synteny_regions",
        sketch_size = 50000
    threads: workflow.cores
    shell:
        r"""
        set -euo pipefail
        mkdir -p {MASH_DIR}

        # Build a temporary file list for this region type
        fa_list=$(ls {params.regions}/*.{wildcards.region_type}.fa)
        echo ${{fa_list}}
        mash triangle -p {threads} -s {params.sketch_size} -E ${{fa_list}} > {output.dist}
        """


# ===========================================================================
# Tally block discontinuity reasons
# ===========================================================================

rule discontinuity_reasons:
    """Count occurrences of each value in the discontinuity_reason column (col 8)."""
    input:
        blocks = BLOCKS_TSV,
    output:
        tsv = f"{NTSYNT_STEM}.discontinuity_reasons.tsv",
    shell:
        r"""
        set -eux -o pipefail
        cat {input.blocks} | mlr --tsv --implicit-csv-header label block_id,genome,chrom,start,end,strand,n_mx,discontinuity_reason \
            then uniq -g discontinuity_reason,block_id  \
            then stats1 -a count -f discontinuity_reason -g discontinuity_reason \
            then sort -nr discontinuity_reason_count \
            then filter '$discontinuity_reason != "None"' \
        > {output.tsv}
        """


# ===========================================================================
# 15. Plot divergence distributions
# ===========================================================================

rule plot_divergences:
    input:
        full_dists  = f"{MASH_DIR}/full_assemblies_dist.tsv",
        syntenic    = f"{MASH_DIR}/syntenic_dists.tsv",
        nonsyntenic = f"{MASH_DIR}/non_syntenic_dists.tsv",
        name_conv = rules.finalize_name_conversion.output.format_name_conv,
    output:
        pdf = f"{MASH_DIR}/mash_divergence_boxplot.pdf",
        png = f"{MASH_DIR}/mash_divergence_boxplot.png",
        html = f"{MASH_DIR}/mash_divergence_boxplot.html"
    params:
        mash_dir = MASH_DIR,
        script      = f"{SCRIPTS}/plot_dists.R",
        out_prefix = f"{MASH_DIR}/mash_divergence_boxplot"
    shell:
        r"""
        set -eux -o pipefail
        Rscript {params.script} --full {input.full_dists} --syntenic {input.syntenic} --non-syntenic {input.nonsyntenic} --name-conversions {input.name_conv} -o {params.out_prefix}
        """

# ===========================================================================
# HTML report
# ===========================================================================

def get_tree_type(wildcards, input):
    "Return string corresponding to tree (or lack thereof) type used in ribbon plot"
    if TREEFILE:
        return "Provided"
    if MAKE_TREE:
        if MT_GENOMES:
            return "mt"
        with open(input.nuclear_tree_flag, 'r') as fin:
            flag = fin.readline().strip()
            if flag == "1":
                return "Nuclear"
            if flag == "0":
                return "mt"
    return "none"

rule generate_report:
    """
    Collate pipeline outputs into a single self-contained HTML report.
    All tables and images are embedded as base64 — no external files needed.
    """
    input:
        abyss_fac     = f"{ASSEMBLY_DIR}/{PREFIX}_abyss_fac-summary.tsv",
        block_stats   = f"{NTSYNT_STEM}.synteny_blocks.stats.tsv",
        ribbon_plot   = rules.run_ntsynt_viz.output.out_html,
        ribbon_plot_image = f"{VIZ_DIR}/{NTSYNT_VIZ_RIBBON_PLOT}",
        discontinuity = f"{NTSYNT_STEM}.discontinuity_reasons.tsv",
        mash_plot     = f"{MASH_DIR}/mash_divergence_boxplot.html",
        mash_plot_image     = f"{MASH_DIR}/mash_divergence_boxplot.png",
        nuclear_tree_flag = rules.make_tree.output.out_type if MAKE_TREE else []
    output:
        html = f"{PREFIX}_ntsynt_report.html",
        pdf = f"{PREFIX}_ntsynt_report.pdf",
    params:
        script = f"{SCRIPTS}/generate_report.py",
        group  = PREFIX,
        prefix = f"{PREFIX}_ntsynt_report",
        tree_type = get_tree_type
    shell:
        r"""
        python3 {params.script} \
         --abyss-fac     {input.abyss_fac} \
         --block-stats   {input.block_stats} \
          --ribbon-plot   {input.ribbon_plot} \
          --ribbon-plot-img {input.ribbon_plot_image} \
          --discontinuity {input.discontinuity} \
          --mash-plot     {input.mash_plot} \
          --mash-plot-img {input.mash_plot_image} \
           --group         {params.group} \
           --output        {params.prefix} \
           --tree {params.tree_type}
        """